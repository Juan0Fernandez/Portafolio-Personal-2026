---
// src/components/Hero.astro
---
<section id="inicio" class="min-h-[90vh] flex items-center justify-center px-6 md:px-12 pt-20">
  <div class="container mx-auto grid md:grid-cols-2 gap-12 items-center">
    
    <div class="space-y-8 flex flex-col justify-center text-center md:text-left">
      <h1 class="text-5xl md:text-6xl font-extrabold tracking-tighter leading-tight text-gray-900 dark:text-white transition-colors duration-300"
          data-es="Construyendo ecosistemas <br class='hidden md:block' /> <span class='text-ciber-green'>digitales</span>."
          data-en="Building <span class='text-ciber-green'>digital</span> <br class='hidden md:block' /> ecosystems.">
          Construyendo ecosistemas  <br class="hidden md:block" />  <span class="text-ciber-green">digitales</span>.
      </h1>
      
      <p class="text-xl max-w-2xl mx-auto md:mx-0 text-gray-700 dark:text-gray-300 transition-colors duration-300"
         data-es="Soy Juan Fernandez. Un desarrollador apasionado por crear soluciones tecnológicas. Combino una sólida base algorítmica con el desarrollo moderno para construir aplicaciones rápidas, seguras, escalables e innovadoras. ¡Bienvenido a mi espacio digital!"
         data-en="I'm Juan Fernandez. A passionate developer creating technological solutions. I combine a solid algorithmic foundation with modern development to build fast, secure, scalable, and innovative applications. Welcome to my digital space!">
        Soy Juan Fernandez. Un desarrollador apasionado por crear soluciones tecnológicas. Combino una sólida base algorítmica con el desarrollo moderno para construir aplicaciones rápidas, seguras, escalables e innovadoras. ¡Bienvenido a mi espacio digital!
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start items-center">
        <a href="#proyectos" class="bg-ciber-green text-dark-bg px-8 py-3 rounded-full font-bold text-lg hover:bg-ciber-green/80 transition-all text-center"
           data-es="Mis proyectos" data-en="My projects">
          Mis proyectos
        </a>
      </div>
    </div>
    
    <div class="relative flex justify-center items-center">
      <img 
        src="/img/Panda.png" 
        alt="Panda cibernético " 
        class="w-full max-w-max object-contain relative z-10 drop-shadow-[0_0_30px_rgba(0,255,65,0.2)] hover:scale-105 transition-transform duration-500"
      />
      <div class="absolute -top-10 -left-10 w-24 h-24 bg-ciber-green/20 rounded-full blur-3xl opacity-60"></div>
      <div class="absolute -bottom-10 -right-10 w-32 h-32 bg-ciber-purple/20 rounded-full blur-3xl opacity-60"></div>
    </div>

  </div>
</section>